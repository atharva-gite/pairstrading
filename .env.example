# Any one key turns on the AI Report, the desk briefing, and Research.
# With several keys, providers are tried in order; a rate limit falls through.
# Leave a key blank if you do not have it. Never commit a filled-in .env.
#
# Groq          https://console.groq.com/keys
GROQ_API_KEY=
# Google Gemini https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Cerebras      https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# Mistral       https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# OpenRouter    https://openrouter.ai/keys
OPENROUTER_API_KEY=
# GitHub Models https://github.com/settings/tokens  (Models permission)
GITHUB_MODELS_TOKEN=

# Optional. Blank means the built-in default model for that provider.
LLM_PROVIDERS=groq,gemini,cerebras,mistral,openrouter,github
GROQ_MODEL=
GEMINI_MODEL=
CEREBRAS_MODEL=
MISTRAL_MODEL=
OPENROUTER_MODEL=
GITHUB_MODEL=
